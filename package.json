{
  "name": "the-real-bitwarden-mcp",
  "version": "0.1.0",
  "description": "Local stdio MCP server for the Bitwarden Public API and Secrets Manager — members, groups, collections, policies, license seats, SM projects and secrets.",
  "type": "module",
  "main": "dist/index.js",
  "bin": { "bitwarden-mcp": "dist/index.js" },
  "files": ["dist/", "README.md", "LICENSE", ".env.example"],
  "publishConfig": {
    "access": "public"
  },
  "author": "Manuel Guttmann",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mguttmann/the-real-bitwarden-mcp.git"
  },
  "homepage": "https://github.com/mguttmann/the-real-bitwarden-mcp#readme",
  "bugs": {
    "url": "https://github.com/mguttmann/the-real-bitwarden-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "bitwarden",
    "bitwarden-public-api",
    "bitwarden-secrets-manager",
    "claude",
    "ai-tools",
    "stdio"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "prepublishOnly": "npm run build && npm test",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "RUN_LIVE_TESTS=1 vitest run tests/live-smoke.test.ts",
    "generate": "tsx scripts/generate.ts",
    "refresh-spec": "tsx scripts/refresh-spec.ts",
    "refresh-snapshot": "tsx scripts/refresh-snapshot.ts",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "dotenv": "^16.4.0",
    "pino": "^9.0.0"
  },
  "optionalDependencies": {
    "@bitwarden/sdk-napi": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.12"
  },
  "engines": { "node": ">=20.0.0" }
}
