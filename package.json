{
  "name": "the-real-bitwarden-mcp",
  "mcpName": "io.github.mguttmann/the-real-bitwarden-mcp",
  "version": "0.2.0",
  "description": "Unofficial local stdio MCP server for the Bitwarden Public API and Secrets Manager: members, groups, collections, policies, license seats, SM projects and secrets. Not affiliated with Bitwarden Inc.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "bitwarden-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "NOTICE",
    "LICENSE",
    ".env.example"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "author": "Manuel Guttmann",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mguttmann/the-real-bitwarden-mcp.git"
  },
  "homepage": "https://github.com/mguttmann/the-real-bitwarden-mcp#readme",
  "bugs": {
    "url": "https://github.com/mguttmann/the-real-bitwarden-mcp/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "bitwarden",
    "bitwarden-public-api",
    "bitwarden-secrets-manager",
    "password-manager",
    "secrets-manager",
    "self-hosted",
    "credentials",
    "claude",
    "claude-code",
    "anthropic",
    "ai-tools",
    "stdio",
    "typescript"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "prepublishOnly": "npm run build && npm test",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:contract": "vitest run tests/tool-contract.test.ts tests/protocol-versions.test.ts",
    "test:live": "RUN_LIVE_TESTS=1 vitest run tests/live-smoke.test.ts",
    "generate": "tsx scripts/generate.ts",
    "refresh-spec": "tsx scripts/refresh-spec.ts",
    "refresh-snapshot": "tsx scripts/refresh-snapshot.ts",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "dotenv": "^18.0.8",
    "pino": "^10.4.0"
  },
  "optionalDependencies": {
    "@bitwarden/sdk-napi": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
