# At least one of (selfhost) or (cloud) MUST be fully configured.

# --- Self-hosted Bitwarden (operational) ---
BITWARDEN_SELFHOST_API_BASE=https://<your-selfhost-host>/api
BITWARDEN_SELFHOST_IDENTITY_URL=https://<your-selfhost-host>/identity
BITWARDEN_SELFHOST_CLIENT_ID=organization.<uuid>
BITWARDEN_SELFHOST_CLIENT_SECRET=<set me>

# --- Bitwarden Cloud (license / subscription, by convention) ---
BITWARDEN_CLOUD_API_BASE=https://api.bitwarden.com
BITWARDEN_CLOUD_IDENTITY_URL=https://identity.bitwarden.com
BITWARDEN_CLOUD_CLIENT_ID=organization.<uuid>
BITWARDEN_CLOUD_CLIENT_SECRET=<set me>

# --- Secrets Manager (uses the self-host host) ---
BWS_API_BASE=https://<your-selfhost-host>/api
BWS_IDENTITY_URL=https://<your-selfhost-host>/identity
BWS_ACCESS_TOKEN=<machine-account access token>
BWS_ORG_ID=<organization uuid>

# --- Behaviour ---
BITWARDEN_CONFIRM_WRITES=true
LOG_LEVEL=warn
HTTP_TIMEOUT_MS=30000
PAGINATION_MAX_ITEMS=1000
PAGINATION_MAX_PAGES=20
